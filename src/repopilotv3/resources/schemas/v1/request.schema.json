                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
